---
title: LiteLLM image upgrade and rollback
---
flowchart TD
  %% Source for 17-upgrade-rollback-flow.html. Edit this file, then run ./scripts/render-diagrams.py.
  %% Directives: docs in diagrams/README.md (Updating diagrams).
  %% @subtitle Compatibility check, rollback point, regression suite, and the two rollback modes

  S(["CANDIDATE TAG@DIGEST"])
  CMP["Isolated compatibility check"]
  CPASS{"Compatible?"}
  STOP(["KEEP THE CURRENT IMAGE"])
  PREP["Capture images, checksums, and a backup"]
  UPD["Update digests and recreate the proxies"]
  VER["Run verify-litellm-upgrade.py"]
  VPASS{"All checks pass?"}
  DONE(["UPGRADE COMPLETE"])
  SCH{"Prior image reads the current schema?"}
  IMG["Rollback --mode image-only"]
  RDB["Rollback --mode restore-db"]
  LIVE["Check proxy liveliness and write a report"]
  E(["ROLLED BACK"])

  S --> CMP
  CMP --> CPASS
  CPASS -->|"no"| STOP
  CPASS -->|"yes"| PREP
  PREP --> UPD
  UPD --> VER
  VER --> VPASS
  VPASS -->|"yes"| DONE
  VPASS -->|"no"| SCH
  SCH -->|"yes"| IMG
  SCH -->|"no"| RDB
  IMG --> LIVE
  RDB --> LIVE
  LIVE --> E
