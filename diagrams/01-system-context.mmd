  subgraph CL["Clients — outside the stack"]
    BR["Web browser<br/>Admin UI · Chat UI · dashboards"]:::frontend
    API["API client / SDK<br/>OpenAI-compatible · virtual key"]:::frontend
    AG["Agent / MCP client<br/>tools via LiteLLM MCP"]:::frontend
  end
  subgraph ST["LiteLLM stack — Docker Compose host"]
    TR["Traefik<br/>TLS 1.2+ · HSTS · runaway limits"]:::cloud
    LL["LiteLLM gateway<br/>prod / dev profile"]:::backend
    OSD["OpenSearch Dashboards<br/>multi-user observability UI"]:::frontend
    OPT["Optional UIs<br/>Grafana · Langfuse profiles"]:::frontend
    PR["Presidio<br/>PII analyzer + anonymizer"]:::security
    SX["SearXNG<br/>internal-only search"]:::backend
    XB["Xberg MCP<br/>document extraction sandbox"]:::backend
    PG[("PostgreSQL<br/>litellm_prod · litellm_dev")]:::database
    OBS[("Observability<br/>Data Prepper · OpenSearch · Prometheus")]:::database
    SQ["Squid egress proxy<br/>allowlist · denies private ranges"]:::security
  end
  subgraph EX["External services — outside the stack"]
    OAI["OpenAI API<br/>completion provider"]:::external
    D3["Remote GPU host<br/>D3-mini classifier · dev BGE-M3"]:::external
    SE["Public search engines<br/>scraped by SearXNG"]:::external
    WEB["Allowlisted websites<br/>security/xberg-egress-allowlist"]:::external
  end

