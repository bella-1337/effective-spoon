sequenceDiagram
  %% Source for 20-ci-release-flow.html. Edit this file, then run ./scripts/render-diagrams.py.
  %% Directives: docs in diagrams/README.md (Updating diagrams).
  %% @subtitle Identical GitHub Actions and GitLab CI pipelines, the documentation site, and where a human still deploys
  %% @type cloud: CI
  %% @type security: REL
  %% @type external: PAGES
  actor DEV as Contributor
  participant CI as GitHub Actions or GitLab CI
  participant REL as Release job
  participant PAGES as GitHub or GitLab Pages
  actor OP as Operator

  DEV->>CI: PR, MR, push, tag, or schedule
  par checks
    CI->>CI: scripts/ci/validate.sh
  and
    CI->>CI: ShellCheck, Hadolint, and Actionlint
  and
    CI->>CI: Gitleaks history scan
  and
    CI->>CI: image build and KEV gate
  and
    CI->>CI: Trivy dependency scan
  and
    CI->>CI: dev container build
  and
    CI->>CI: versioned documentation site build
  end
  alt a check fails
    CI--xDEV: change blocked
  else all checks pass
    alt semantic-version tag
      CI->>REL: release approval
      REL->>REL: publish source bundle and SHA256SUMS
      REL-)OP: operator deploys on-prem
    else no tag
      CI-->>DEV: ready to merge
    end
  end
  opt default branch or release tag, Pages enabled
    alt Pages visibility check passed
      CI->>PAGES: docs site updated
    else check failed
      CI--xDEV: publishing refused
    end
  end
