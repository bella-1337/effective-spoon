  subgraph CL["Clients — outside the stack"]
    AG["MCP client / agent<br/>trusted key or team"]:::frontend
  end
  subgraph ST["LiteLLM stack — Docker Compose host"]
    TR["Traefik<br/>HTTPS"]:::cloud
    LL["LiteLLM gateway<br/>allowed_tools · tool-output injection screen"]:::backend
    subgraph SBX["xberg-sandbox network"]
      XB["Xberg MCP<br/>Streamable HTTP :8001"]:::backend
    end
    subgraph EGR["egress network"]
      DNS["xberg-dns<br/>allowlist-only resolver"]:::security
      SQ["Squid egress proxy<br/>HTTPS-only allowlist"]:::security
    end
  end
  subgraph EX["External services — outside the stack"]
    PDNS["Public DNS<br/>name resolution"]:::external
    ALW["Allowlisted websites<br/>e.g. docs.xberg.io"]:::external
    BLK["Other destinations<br/>private · unlisted · plain HTTP"]:::external
  end

  AG ==>|"HTTPS + virtual key"| TR
  TR ==> LL
  LL ==>|"MCP tools/call"| XB
  XB -->|"allowlisted names only"| DNS
  XB ==>|"HTTPS CONNECT via proxy"| SQ
  DNS --> PDNS
  SQ ==> ALW
  SQ ---|"denied"| BLK

