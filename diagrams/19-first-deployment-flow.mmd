  S(["CLONE THE REPOSITORY"])
  ENV["Create .env and set STACK_DOMAIN"]
  TLS{"On-prem certificate delivered?"}
  DEL["Point Traefik at the delivered cert and key"]
  MK["mkcert local-development fallback"]
  HOST["Resolve the hostnames"]
  GF{"Enabling the grafana profile?"}
  FD["Fetch pinned Grafana dashboards"]
  KEY["Write the Prometheus metrics key file"]
  VAL["docker compose config --quiet"]
  UP["Start the prod and/or dev profile"]
  E(["VERIFY HEALTH AND ROUTES"])

  S --> ENV
  ENV --> TLS
  TLS -->|"yes"| DEL
