  S(["RULES IN GRAFANA/ALERTING"])
  SET["opensearch-setup creates one monitor per rule"]
  EV["Bridge evaluates each PromQL rule every minute"]
  ST["Write litellm-alert-state-*"]
  FOR{"Condition held for the full 'for' duration?"}
  OK(["NO ALERT"])
  CHN{"Alert channel configured?"}
  UI(["VISIBLE IN THE UI ONLY"])
  E(["OPERATOR NOTIFIED"])

  S --> SET
  SET --> EV
  EV --> ST
  ST --> FOR
  FOR -->|"no"| OK
  FOR -->|"yes"| CHN
  CHN -->|"no"| UI
  CHN -->|"yes"| E
