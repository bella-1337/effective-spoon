  subgraph CL["Clients — outside the stack"]
    CU["Chat UI / API client<br/>dev hostname only"]:::frontend
  end
  subgraph ST["LiteLLM stack — Docker Compose host"]
    TR["Traefik<br/>LITELLM_DEV_HOST"]:::cloud
    LD["litellm-dev<br/>cache · vector stores · MCP filter"]:::backend
    PR["Presidio<br/>auto-index: anonymize chunks"]:::security
    VP[("vector-postgres<br/>sme-knowledge · auto-index writes")]:::database
    subgraph DEV["dev profile only"]
      QD[("Qdrant<br/>semantic cache · 1 GB tmpfs")]:::database
      CON["litellm-pgvector<br/>vector-store connector"]:::backend
    end
  end
  subgraph EX["External services — outside the stack"]
    BGE["Remote BGE-M3<br/>GPU host · plain HTTP"]:::external
    OAI["OpenAI API<br/>generation on cache miss"]:::external
  end

  CU ==>|"HTTPS"| TR
  TR ==> LD
  LD -->|"cache lookup"| QD
  LD -->|"embed · HTTP"| BGE
  LD -->|"vector search"| CON
  CON --> VP
  LD -.-> PR
  LD -.-> VP
  LD ==> OAI

