flowchart TD
  %% Source for 02-network-boundaries.html. Edit this file, then run ./scripts/render-diagrams.py.
  %% Directives: docs in diagrams/README.md (Updating diagrams).
  %% @mode architecture
  %% @subtitle Each Compose network is a trust zone; only Traefik publishes host ports
  %% @card cyan | Ingress | Only Traefik publishes host ports 80 and 443 | edge members are reachable only through a Traefik host rule | SearXNG, databases, and telemetry have no route from clients
  %% @card violet | Isolation | Xberg sits alone on xberg-sandbox with LiteLLM and its proxies | Its outbound HTTPS goes through Squid and its DNS through an allowlist-only resolver | opensearch-certs runs with no network at all
  %% @card rose | Docker socket | Traefik, Alloy, and the image scanner never mount the socket | Each reaches Docker through its own socket proxy on a dedicated network | The proxies allow read-only GET calls; POST is disabled
  %% @journey #22d3ee: CLI TR LL PROV
  %% @journey #34d399: LL XB SQ NET
  %% @journey #fb7185: TR TDP DOCK

  subgraph CL["Clients — outside the stack"]
    CLI["Client<br/>browser · SDK · agent"]:::frontend
  end
  subgraph HOST["Docker host"]
    subgraph EDGE["edge network — Traefik-routed"]
      TR["Traefik<br/>publishes :80 and :443"]:::cloud
      LL["LiteLLM prod / dev<br/>also on internal + xberg-sandbox"]:::backend
      OSD["OpenSearch Dashboards<br/>also on internal"]:::frontend
      WEBUI["Grafana · Langfuse web<br/>optional profiles"]:::frontend
      LENS["Lens (optional)<br/>also on internal + lens-storage"]:::backend
    end
    subgraph INT["internal network — service-to-service"]
      PR["Presidio<br/>analyzer · anonymizer"]:::security
      SX["SearXNG<br/>no Traefik route"]:::backend
      DB[("PostgreSQL · pgvector<br/>no host ports")]:::database
      OS[("OpenSearch · Data Prepper<br/>private-CA TLS")]:::database
      PM["Prometheus · exporters<br/>scrapes every job"]:::backend
    end
    subgraph LSN["lens-storage — internal, Lens only"]
      LCH[("Lens ClickHouse<br/>no route from any other service")]:::database
    end
    subgraph SBX["xberg-sandbox — internal-only MCP"]
      XB["Xberg MCP<br/>no Internet, no internal route"]:::backend
    end
    subgraph EGR["egress — the only Internet route for Xberg"]
      DNS["xberg-dns<br/>allowlist-only resolver"]:::security
      SQ["xberg-egress-proxy<br/>Squid allowlist"]:::security
    end
    subgraph MON["*-monitor networks — read-only Docker access"]
      TDP["traefik-docker-proxy<br/>traefik-monitor · routing metadata"]:::security
      ADP["alloy-docker-proxy<br/>alloy-monitor"]:::security
      SDP["image-security proxy<br/>security-monitor"]:::security
      DOCK["Docker Engine API<br/>read-only · POST disabled"]:::cloud
    end
  end
  subgraph EX["External services — outside the stack"]
    PROV["Model providers<br/>OpenAI · remote GPU host"]:::external
    NET["Allowlisted Internet<br/>public DNS + websites"]:::external
  end

