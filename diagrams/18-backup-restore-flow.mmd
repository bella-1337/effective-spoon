flowchart TD
  %% Source for 18-backup-restore-flow.html. Edit this file, then run ./scripts/render-diagrams.py.
  %% Directives: docs in diagrams/README.md (Updating diagrams).
  %% @subtitle Validated, checksummed backups and a restore that never drops the existing database first

  S(["BACKUP-DATABASES.PY"])
  P["Dump litellm_prod"]
  D["Dump litellm_dev"]
  V["Dump vector_store"]
  CHK["Validate with pg_restore and write SHA256SUMS"]
  PUB["Atomically publish under backups/"]
  RS["restore --confirm-restore"]
  STG["Restore into a staging database"]
  TOK{"Tables restored?"}
  KEEP(["TARGET LEFT UNTOUCHED"])
  SWAP["Rename target to *_pre_restore_*, promote staging"]
  E(["RESTORED — RERUN STACK CHECKS"])

  S --> P
  S --> D
  S --> V
  P --> CHK
  D --> CHK
  V --> CHK
  CHK --> PUB
  PUB --> RS
  RS --> STG
  STG --> TOK
  TOK -->|"no"| KEEP
  TOK -->|"yes"| SWAP
  SWAP --> E
