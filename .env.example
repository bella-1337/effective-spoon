# Copy this file to .env, replace every REQUIRED placeholder, and review all
# OPTIONAL defaults before starting the stack. Never commit the resulting .env.

# -----------------------------------------------------------------------------
# Stack identity, routing, and shared operational defaults
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=litellm-stack
STACK_TIMEZONE=Europe/Berlin
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
DOCKER_SOCKET_PROXY_LOG_LEVEL=warning

# Host paths populated by the on-prem certificate delivery process.
TRAEFIK_TLS_CERT_FILE=./traefik/certs/litellm-stack.pem
TRAEFIK_TLS_KEY_FILE=./traefik/certs/litellm-stack-key.pem

# Base DNS domain of this deployment. Every public hostname below (and in
# .env.optional) is derived from it, so a new environment normally changes only
# this line. Override an individual *_HOST with a full hostname when it does
# not follow the <service>.${STACK_DOMAIN} convention.
STACK_DOMAIN=example.test

# Core hostnames covered by the delivered certificate. Docker Compose and the
# maintenance scripts expand ${STACK_DOMAIN}.
LITELLM_PROD_HOST=llm.${STACK_DOMAIN}
LITELLM_DEV_HOST=llm-dev.${STACK_DOMAIN}
OPENSEARCH_DASHBOARDS_HOST=opensearch.${STACK_DOMAIN}

# -----------------------------------------------------------------------------
# DATA SOVEREIGNTY: region lock and provider models
# DATA_SOVEREIGNTY_REGION is the geography every cloud model must stay in: "eu"
# (EU member states) or "us". No provider model is required. A provider is
# enabled only when its model list below is set; the LiteLLM launcher then
# wires those models into both gateways and refuses to start when a credential
# is missing or a provider location could process prompts outside the region.
# Lists are comma-separated; write model-name=ID to choose the public model
# name. See docs/data-sovereignty.md for the allowed locations per region.
# -----------------------------------------------------------------------------
DATA_SOVEREIGNTY_REGION=eu

# Amazon Bedrock. Model IDs without a routing prefix; the region's geographic
# inference profile ("eu." or "us.") is added for you. BEDROCK_AWS_REGION is the
# source Region, for example eu-central-1 for "eu" or us-east-1 for "us".
# Example: BEDROCK_MODELS=anthropic.claude-opus-5-5,anthropic.claude-sonnet-5-5,anthropic.claude-haiku-5-5
BEDROCK_MODELS=
BEDROCK_AWS_REGION=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# Azure OpenAI. Deployment names on a resource in AZURE_OPENAI_REGION (for
# example swedencentral for "eu" or eastus2 for "us"); create them as
# DataZoneStandard or Standard (regional) deployments, never GlobalStandard.
# Example: AZURE_OPENAI_DEPLOYMENTS=gpt-5.5,gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENTS=
AZURE_OPENAI_REGION=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
# Optional; defaults to 2025-04-01-preview.
AZURE_OPENAI_API_VERSION=

# Google Vertex AI. VERTEX_LOCATION is "eu" or "us" (multi-region) or a
# single region inside DATA_SOVEREIGNTY_REGION; never "global".
# VERTEX_CREDENTIALS_FILE is a service-account key file name inside
# PROVIDER_SECRETS_DIR, readable by the container user:
#   chown 65532:65532 <file> && chmod 0400 <file>
# Example: VERTEX_MODELS=gemini-4-argon,gemini-3.5-flash
VERTEX_MODELS=
VERTEX_LOCATION=
VERTEX_PROJECT=
VERTEX_CREDENTIALS_FILE=
# Host directory mounted read-only at /app/secrets in both gateways. Ignored by Git.
PROVIDER_SECRETS_DIR=./litellm/provider-secrets

# coding-router: enabled when CODING_ROUTER_DEFAULT_MODEL names a provider model
# above. Each tier defaults to that model. A tier may list several models
# (comma-separated); the router then picks between them.
CODING_ROUTER_DEFAULT_MODEL=
CODING_ROUTER_SIMPLE_MODEL=
CODING_ROUTER_MEDIUM_MODEL=
CODING_ROUTER_COMPLEX_MODEL=
CODING_ROUTER_REASONING_MODEL=
# d3-mini (default) classifies with the self-hosted model; heuristic scores the
# prompt locally with no model call. A failed or slow D3-mini call falls back
# to the heuristic. Timeout in milliseconds, default 3000.
CODING_ROUTER_CLASSIFIER=
CODING_ROUTER_CLASSIFIER_TIMEOUT_MS=
# Comma-separated words or phrases that send a request straight to a tier,
# checked before classification, e.g. CODING_ROUTER_REASONING_KEYWORDS=architecture
CODING_ROUTER_SIMPLE_KEYWORDS=
CODING_ROUTER_MEDIUM_KEYWORDS=
CODING_ROUTER_COMPLEX_KEYWORDS=
CODING_ROUTER_REASONING_KEYWORDS=
# true/false, all default false. ADAPTIVE learns which model of a tier works
# best. SESSION_AFFINITY keeps a conversation (client session_id) on one model
# for prompt-cache reuse. STALL_ESCALATION moves a stuck agent task up a tier;
# it cannot be combined with SESSION_AFFINITY.
CODING_ROUTER_ADAPTIVE=
CODING_ROUTER_SESSION_AFFINITY=
CODING_ROUTER_STALL_ESCALATION=

# -----------------------------------------------------------------------------
# Corporate branding (LiteLLM-native settings only)
# LiteLLM serves logo and favicon files from a local PNG, JPEG, GIF, WEBP, or ICO
# path, or redirects browsers to an https:// URL. SVG files must be URLs.
# -----------------------------------------------------------------------------
BRAND_COMPANY_NAME=Foo-Bar
# Host directory mounted read-only at /app/branding in both LiteLLM containers.
BRAND_ASSETS_DIR=./branding/foo-bar
UI_LOGO_PATH=/app/branding/logo.png
UI_LOGO_PATH_DARK=/app/branding/logo-dark.png
LITELLM_FAVICON_URL=/app/branding/favicon.png
# LiteLLM Enterprise branding: an unlicensed proxy ignores these values and
# keeps its defaults. Delete a line, rather than leaving it empty, to keep the
# LiteLLM default for that setting.
DOCS_TITLE=${BRAND_COMPANY_NAME} AI Gateway
DOCS_DESCRIPTION=${BRAND_COMPANY_NAME} AI Gateway: OpenAI-compatible access to approved models.
# Must be an https:// URL to a PNG or JPEG reachable by recipients' mail clients.
EMAIL_LOGO_URL=https://${LITELLM_PROD_HOST}/get_image
EMAIL_SUPPORT_CONTACT=ai-support@${STACK_DOMAIN}
EMAIL_SUBJECT_INVITATION=${BRAND_COMPANY_NAME} AI Gateway: {event_message}
EMAIL_SUBJECT_KEY_CREATED=${BRAND_COMPANY_NAME} AI Gateway: {event_message}
EMAIL_SUBJECT_KEY_ROTATED=${BRAND_COMPANY_NAME} AI Gateway: {event_message}

# -----------------------------------------------------------------------------
# REQUIRED credentials and cryptographic material
# -----------------------------------------------------------------------------
PG_USER=litellm
PG_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DATABASE_PASSWORD=replace_with_url_safe_random_password
PG_EXPORTER_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_EXPORTER_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_API_KEY=replace_with_random_pgvector_api_key
QDRANT_API_KEY=replace_with_random_qdrant_api_key
LITELLM_MASTER_KEY=sk-replace_with_random_master_key
# D3-mini on the remote GPU host, deployed with gpu-host/deploy.py. With the
# optional on-host d3 profile, set http://d3-mini:8000 instead; the gateways
# accept plain HTTP for that address only.
D3_DECISION_API_BASE=https://d3-mini.${STACK_DOMAIN}:8443
D3_DECISION_API_KEY=replace_with_random_32_byte_d3_api_key
# Optional local model that detects each prompt's language (en, de, fr) and
# personal data before Presidio masks it (pii-assist guardrail). Prompts reach
# it unmasked, so it must run on this host or a private network, never a cloud
# API. Empty: Presidio runs alone, in English. Example: Ollama on the Docker
# host, http://host.docker.internal:11434, with `ollama pull qwen3.5:4b`.
PII_ASSIST_API_BASE=
PII_ASSIST_OLLAMA_MODEL=qwen3.5:4b
# Characters per model call, model calls per request for new text, and the
# timeout of one call in seconds. Text over the call budget is masked by
# Presidio alone; results are cached per text, so a conversation's history is
# not analysed again.
PII_ASSIST_MAX_CHUNK_CHARS=4000
PII_ASSIST_MAX_CALLS=3
PII_ASSIST_TIMEOUT_SECONDS=20
# Public roots plus the GPU host's mkcert root CA, built with
# scripts/build-gpu-host-ca-bundle.py. LiteLLM verifies D3-mini, BGE-M3, and
# every completion provider against this single file.
GPU_HOST_CA_BUNDLE=./traefik/certs/gpu-host-ca-bundle.pem
# Remote BGE-M3 embeddings (dev profile) on Text Embeddings Inference behind the
# GPU host's TLS proxy, deployed with gpu-host/deploy.py. Include /v1. Prod never
# calls BGE-M3, but Compose still requires a value there.
BGE_M3_API_BASE=https://bge-m3.${STACK_DOMAIN}:9443/v1
BGE_M3_API_KEY=replace_with_random_32_byte_bge_m3_api_key
# OpenSearch is the default observability store and multi-user UI. Use
# URL-safe characters ([A-Za-z0-9._~-]) of at least 16 characters for every
# OpenSearch password; the master key must be exactly 32 characters.
OPENSEARCH_ADMIN_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DASHBOARDS_SERVER_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DASHBOARDS_COOKIE_PASSWORD=replace_with_random_cookie_secret_of_32_or_more_chars
OPENSEARCH_INGEST_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_BRIDGE_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DATASOURCES_MASTER_KEY=replace_with_32_char_random_key0
OPENSEARCH_SESSION_ID_SALT=replace_with_random_session_id_hmac_salt
SEARXNG_SECRET=replace_with_random_searxng_secret

# -----------------------------------------------------------------------------
# OPTIONAL core-side Langfuse integration
# These values are consumed by LiteLLM and OpenSearch even though the Langfuse
# infrastructure itself remains in .env.optional. Leave them empty unless the
# langfuse profile is enabled.
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_USER_ID_SALT=

# -----------------------------------------------------------------------------
# OPTIONAL core-side LiteLLM Lens connection
# Both LiteLLM gateways and Lens use these two secrets, so they live here even
# though the Lens infrastructure stays in .env.optional. Leave them empty unless
# the lens profile is enabled; then use two different values of 32-512
# characters, for example from `openssl rand -hex 32`
# (scripts/lens.py secrets generates any that are missing).
# -----------------------------------------------------------------------------
# Authenticates LiteLLM's internal requests and spend export to Lens.
LITELLM_LENS_SERVICE_TOKEN=
# Lets Lens verify the dashboard user identity that LiteLLM signs.
LENS_GATEWAY_SECRET=

# -----------------------------------------------------------------------------
# LiteLLM and observability behavior
# -----------------------------------------------------------------------------
LITELLM_STORE_MODEL_IN_DB=True
# LiteLLM 1.108.x cannot verify and baseline this stack's fresh Wolfi-backed
# databases with its v2 resolver. Keep the legacy fallback until that path works.
LITELLM_USE_V2_MIGRATION_RESOLVER=false
LITELLM_OTEL_V2=true
LITELLM_FORWARDED_ALLOW_IPS=*
OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=.*
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# -----------------------------------------------------------------------------
# Resource limits per host (CPU and memory caps, not reservations)
# Defaults suit the dev host. For the prod host values, see README.md
# "Resource limits". Services with their own sizing variables (OpenSearch,
# Data Prepper, Presidio Analyzer, Qdrant, Xberg, image security) keep
# them; everything else long-running belongs to one tier below.
# -----------------------------------------------------------------------------
# Socket proxies, exporters, blackbox
RESOURCE_TINY_CPU_LIMIT=0.5
RESOURCE_TINY_MEMORY_LIMIT=256m
# Traefik, Presidio Anonymizer, SearXNG, egress proxy, bridge, cAdvisor,
# litellm-pgvector, Grafana, Langfuse Redis and MinIO
RESOURCE_SMALL_CPU_LIMIT=1
RESOURCE_SMALL_MEMORY_LIMIT=1g
# Prometheus, Alloy, OpenSearch Dashboards, Loki, alloy-loki, Langfuse web and
# worker; also the Data Prepper CPU cap
RESOURCE_MEDIUM_CPU_LIMIT=2
RESOURCE_MEDIUM_MEMORY_LIMIT=2g
# PostgreSQL, vector-postgres, Langfuse PostgreSQL and ClickHouse, Lens
# ClickHouse; also the OpenSearch CPU cap. Page cache counts against the
# memory cap.
RESOURCE_DATABASE_CPU_LIMIT=2
RESOURCE_DATABASE_MEMORY_LIMIT=4g
# Each LiteLLM proxy (prod and dev). Allow 1 CPU and 4g per worker.
LITELLM_CPU_LIMIT=2
LITELLM_MEMORY_LIMIT=4g

# -----------------------------------------------------------------------------
# OpenSearch (default observability) sizing, retention, and alert routing
# -----------------------------------------------------------------------------
OPENSEARCH_JAVA_HEAP=1g
OPENSEARCH_MEMORY_LIMIT=3g
DATA_PREPPER_JAVA_OPTS=-Xms256m -Xmx512m
DATA_PREPPER_MEMORY_LIMIT=2g
OPENSEARCH_LOG_RETENTION_DAYS=7
OPENSEARCH_METRICS_RETENTION_DAYS=15
OPENSEARCH_USAGE_RETENTION_DAYS=180
OPENSEARCH_AUDIT_RETENTION_DAYS=90
OPENSEARCH_TRACE_RETENTION_DAYS=15
OPENSEARCH_BRIDGE_INTERVAL_SECONDS=60
OPENSEARCH_USAGE_OVERLAP_MINUTES=30
# LiteLLM request/service spans go to OpenSearch Trace Analytics via Data
# Prepper. Set to "console" only for debugging (prints spans to stdout).
LITELLM_OTEL_TRACE_EXPORTER=otlp_grpc
OPENSEARCH_CERT_VALIDITY_DAYS=397
OPENSEARCH_CERT_RENEW_BEFORE_DAYS=30
# ID of a channel created under OpenSearch Dashboards > Notifications. When set,
# every provisioned monitor notifies it. Leave empty until a channel exists.
OPENSEARCH_ALERT_CHANNEL_ID=

# Management ROI assumptions. These are scenario inputs, not measured savings.
# Set per-session minutes to 0 when request-level value already captures the
# whole interaction; otherwise both contributions are added.
ROI_MINUTES_SAVED_PER_REQUEST=15
ROI_MINUTES_SAVED_PER_SESSION=0
ROI_LOADED_HOURLY_COST=75
ROI_VALUE_REALIZATION_FACTOR=0.25
ROI_CURRENCY=USD

# -----------------------------------------------------------------------------
# Development model, cache, routing, and extraction services
# -----------------------------------------------------------------------------
QDRANT_STORAGE_SIZE=1g
QDRANT_CPU_LIMIT=1
QDRANT_MEMORY_LIMIT=2g

PRESIDIO_NLP_ENGINE=spacy
PRESIDIO_ANALYZER_CPU_LIMIT=2
# English, German, and French pipelines, preloaded and shared by the workers:
# about 2.7 GiB with two workers. 2g is too small since German and French.
PRESIDIO_ANALYZER_MEMORY_LIMIT=4g
PRESIDIO_ANALYZER_WORKERS=2
PRESIDIO_ANONYMIZER_WORKERS=2

XBERG_AUTO_INDEX_ENABLED=false
XBERG_INDEX_EMBEDDING_MODEL=hosted_vllm/bge-m3
XBERG_LOG_LEVEL=info
XBERG_MAX_REQUEST_BODY_BYTES=10485760
XBERG_MAX_MULTIPART_FIELD_BYTES=10485760
XBERG_CPU_LIMIT=1
XBERG_MEMORY_LIMIT=1g
XBERG_SANDBOX_SUBNET=172.29.0.0/24
XBERG_DNS_IP=172.29.0.53
XBERG_HEALTHCHECK_DOMAIN=docs.xberg.io

PGVECTOR_EMBEDDING_MODEL=openai/bge-m3
PGVECTOR_EMBEDDING_DIMENSIONS=1024
