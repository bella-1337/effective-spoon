# Copy this file to .env, replace every REQUIRED placeholder, and review all
# OPTIONAL defaults before starting the stack. Never commit the resulting .env.

# -----------------------------------------------------------------------------
# Stack identity, routing, and shared operational defaults
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=litellm-stack
STACK_TIMEZONE=Europe/Berlin
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
DOCKER_SOCKET_PROXY_LOG_LEVEL=warning

# Host paths populated by the on-prem certificate delivery process.
TRAEFIK_TLS_CERT_FILE=./traefik/certs/litellm-stack.pem
TRAEFIK_TLS_KEY_FILE=./traefik/certs/litellm-stack-key.pem

# Public hostnames covered by the delivered certificate.
LITELLM_PROD_HOST=llm.example.test
LITELLM_DEV_HOST=llm-dev.example.test
OPENSEARCH_DASHBOARDS_HOST=opensearch.example.test
# Optional grafana profile only.
GRAFANA_HOST=grafana.example.test
SEARXNG_HOST=search.example.test
LANGFUSE_WEB_HOST=langfuse.example.test
LANGFUSE_S3_HOST=langfuse-s3.example.test

# -----------------------------------------------------------------------------
# REQUIRED credentials and cryptographic material
# -----------------------------------------------------------------------------
PG_USER=litellm
PG_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DATABASE_PASSWORD=replace_with_url_safe_random_password
PG_EXPORTER_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_EXPORTER_PASSWORD=replace_with_url_safe_random_password
PG_VECTOR_API_KEY=replace_with_random_pgvector_api_key
QDRANT_API_KEY=replace_with_random_qdrant_api_key
LITELLM_MASTER_KEY=sk-replace_with_random_master_key
OPENAI_API_KEY=replace_with_your_openai_api_key
D3_DECISION_API_BASE=https://d3-mini.example.test:8443
D3_DECISION_API_KEY=replace_with_random_32_byte_d3_api_key
# PEM bundle containing normal public roots plus the CA that issued D3's certificate.
D3_DECISION_CA_BUNDLE=./traefik/certs/d3-decision-combined-ca.pem
# OpenSearch is the default observability store and multi-user UI. Use
# URL-safe characters ([A-Za-z0-9._~-]) of at least 16 characters for every
# OpenSearch password; the master key must be exactly 32 characters.
OPENSEARCH_ADMIN_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DASHBOARDS_SERVER_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DASHBOARDS_COOKIE_PASSWORD=replace_with_random_cookie_secret_of_32_or_more_chars
OPENSEARCH_INGEST_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_BRIDGE_PASSWORD=replace_with_url_safe_random_password
OPENSEARCH_DATASOURCES_MASTER_KEY=replace_with_32_char_random_key0
SEARXNG_SECRET=replace_with_random_searxng_secret
LANGFUSE_POSTGRES_PASSWORD=replace_with_url_safe_random_password
LANGFUSE_CLICKHOUSE_PASSWORD=replace_with_random_clickhouse_password
LANGFUSE_REDIS_AUTH=replace_with_random_redis_password
LANGFUSE_MINIO_PASSWORD=replace_with_random_minio_password
LANGFUSE_NEXTAUTH_SECRET=replace_with_random_nextauth_secret
LANGFUSE_SALT=replace_with_random_salt
LANGFUSE_ENCRYPTION_KEY=replace_with_64_character_hex_key
LANGFUSE_PUBLIC_KEY=pk-lf-replace_with_random_public_key
LANGFUSE_SECRET_KEY=sk-lf-replace_with_random_secret_key
LANGFUSE_USER_ID_SALT=replace_with_random_user_id_hmac_salt
LANGFUSE_INIT_USER_EMAIL=admin@example.test
LANGFUSE_INIT_USER_NAME=Langfuse Admin
LANGFUSE_INIT_USER_PASSWORD=replace_with_random_admin_password

# -----------------------------------------------------------------------------
# LiteLLM and observability behavior
# -----------------------------------------------------------------------------
LITELLM_STORE_MODEL_IN_DB=True
LITELLM_OTEL_V2=true
LITELLM_FORWARDED_ALLOW_IPS=*
OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=.*
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# -----------------------------------------------------------------------------
# OpenSearch (default observability) sizing, retention, and alert routing
# -----------------------------------------------------------------------------
OPENSEARCH_JAVA_HEAP=1g
OPENSEARCH_MEMORY_LIMIT=3g
DATA_PREPPER_JAVA_OPTS=-Xms256m -Xmx512m
DATA_PREPPER_MEMORY_LIMIT=1g
OPENSEARCH_LOG_RETENTION_DAYS=7
OPENSEARCH_METRICS_RETENTION_DAYS=15
OPENSEARCH_USAGE_RETENTION_DAYS=180
OPENSEARCH_AUDIT_RETENTION_DAYS=90
OPENSEARCH_TRACE_RETENTION_DAYS=15
OPENSEARCH_BRIDGE_INTERVAL_SECONDS=60
OPENSEARCH_USAGE_OVERLAP_MINUTES=30
# LiteLLM request/service spans go to OpenSearch Trace Analytics via Data
# Prepper. Set to "console" only for debugging (prints spans to stdout).
LITELLM_OTEL_TRACE_EXPORTER=otlp_grpc
OPENSEARCH_CERT_VALIDITY_DAYS=397
OPENSEARCH_CERT_RENEW_BEFORE_DAYS=30
# ID of a channel created under OpenSearch Dashboards > Notifications. When set,
# every provisioned monitor notifies it. Leave empty until a channel exists.
OPENSEARCH_ALERT_CHANNEL_ID=

# -----------------------------------------------------------------------------
# OPTIONAL Grafana profile (docker compose --profile grafana ...)
# Leave empty unless the profile is enabled; the grafana container refuses to
# start without them. Grafana OSS lacks per-user data-source permissions, so
# OpenSearch Dashboards is the default multi-user UI.
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECURITY_SECRET_KEY=
GRAFANA_DATABASE_USER=grafana_ro
GRAFANA_DATABASE_PASSWORD=
GRAFANA_ALLOW_SIGN_UP=false

# Management ROI assumptions. These are scenario inputs, not measured savings.
# Set per-session minutes to 0 when request-level value already captures the
# whole interaction; otherwise both contributions are added.
ROI_MINUTES_SAVED_PER_REQUEST=15
ROI_MINUTES_SAVED_PER_SESSION=0
ROI_LOADED_HOURLY_COST=75
ROI_VALUE_REALIZATION_FACTOR=0.25
ROI_CURRENCY=USD

# -----------------------------------------------------------------------------
# Langfuse behavior and initial tenant
# -----------------------------------------------------------------------------
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_REDIS_TLS_ENABLED=false
LANGFUSE_INIT_ORG_ID=litellm-stack
LANGFUSE_INIT_ORG_NAME=LiteLLM Stack
LANGFUSE_INIT_PROJECT_ID=litellm
LANGFUSE_INIT_PROJECT_NAME=LiteLLM
LANGFUSE_TRUSTED_PROXY_COUNT=1
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true

# -----------------------------------------------------------------------------
# Development model, cache, routing, and extraction services
# -----------------------------------------------------------------------------
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_SERVED_MODEL_NAME=bge-m3
BGE_M3_DTYPE=half
BGE_M3_MAX_MODEL_LEN=8192
BGE_M3_VLLM_GPU_MEMORY_UTILIZATION=0.35
BGE_M3_SHM_SIZE=2gb
BGE_M3_MEMORY_LIMIT=6g
BGE_M3_HEALTH_START_PERIOD=15m

QDRANT_STORAGE_SIZE=1g
QDRANT_CPU_LIMIT=1
QDRANT_MEMORY_LIMIT=2g

PRESIDIO_NLP_ENGINE=spacy
PRESIDIO_SUPPORTED_LANGUAGES=en
PRESIDIO_ANALYZER_MEMORY_LIMIT=2g

XBERG_AUTO_INDEX_ENABLED=false
XBERG_INDEX_EMBEDDING_MODEL=hosted_vllm/bge-m3
XBERG_LOG_LEVEL=info
XBERG_MAX_REQUEST_BODY_BYTES=10485760
XBERG_MAX_MULTIPART_FIELD_BYTES=10485760
XBERG_CPU_LIMIT=1
XBERG_MEMORY_LIMIT=1g

PGVECTOR_EMBEDDING_MODEL=openai/bge-m3
PGVECTOR_EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# Image-security monitor
# Linux UID/GID must own security-state/, security-reports/, and security-metrics/.
# -----------------------------------------------------------------------------
IMAGE_SECURITY_UID=1000
IMAGE_SECURITY_GID=1000
IMAGE_SECURITY_SCHEDULE_HOUR=2
IMAGE_SECURITY_SCHEDULE_MINUTE=45
IMAGE_SECURITY_RUN_ON_START=true
IMAGE_SECURITY_CPU_LIMIT=2
IMAGE_SECURITY_MEMORY_LIMIT=2500m
IMAGE_SECURITY_PIDS_LIMIT=256
IMAGE_SECURITY_RESTART_POLICY=on-failure:5
