{
  "uid": "vllm-semantic-router",
  "title": "vLLM Semantic Router",
  "tags": ["litellm", "semantic-router", "development"],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Router and Envoy targets",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "up{job=~\"vllm-semantic-router(|-envoy)\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inference outcomes / second",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum by (outcome) (rate(llm_request_outcomes_total{job=\"vllm-semantic-router\",traffic_kind=\"inference\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Envoy downstream requests / second",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(rate(envoy_http_downstream_rq_total{job=\"vllm-semantic-router-envoy\"}[5m]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model routing latency",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llm_model_routing_latency_seconds_bucket{job=\"vllm-semantic-router\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_model_routing_latency_seconds_bucket{job=\"vllm-semantic-router\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_model_routing_latency_seconds_bucket{job=\"vllm-semantic-router\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Decision evaluations / second",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "rate(llm_decision_evaluation_total{job=\"vllm-semantic-router\"}[5m])",
          "legendFormat": "decisions"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inference error ratio",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(rate(llm_request_outcomes_total{job=\"vllm-semantic-router\",traffic_kind=\"inference\",outcome!=\"success\"}[5m])) / clamp_min(sum(rate(llm_request_outcomes_total{job=\"vllm-semantic-router\",traffic_kind=\"inference\"}[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingress requests rejected by local rate limit",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "sum(rate(envoy_http_local_rate_limit_rate_limited{job=\"vllm-semantic-router-envoy\",envoy_local_http_ratelimit_prefix=\"semantic_router_ingress\"}[5m]))",
          "legendFormat": "rejected requests / second"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
