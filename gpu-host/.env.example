# Copy to gpu-host/.env on the GPU host (install -m 600 .env.example .env),
# replace every placeholder, then run ./deploy.py. Never commit the result.

# -----------------------------------------------------------------------------
# D3-mini Decisions endpoint (verified TLS)
# -----------------------------------------------------------------------------
# DNS name covered by the certificate; the LiteLLM hosts reach D3 through it.
D3_SERVER_NAME=d3-mini.example.test
# Random secret of at least 32 URL-safe characters: openssl rand -hex 32
# Copy it to D3_DECISION_API_KEY on both LiteLLM hosts.
D3_API_KEY=replace_with_random_32_byte_d3_api_key
D3_TLS_CERT_FILE=/secure/path/d3-mini.crt
D3_TLS_KEY_FILE=/secure/path/d3-mini.key
# CA that issued the certificate; used only by the deployment probe.
D3_CA_CERT_FILE=/secure/path/issuing-ca.crt
D3_BIND_ADDRESS=0.0.0.0
D3_PUBLIC_PORT=8443
D3_MEMORY_LIMIT=16g
D3_SHM_SIZE=4gb

# -----------------------------------------------------------------------------
# BGE-M3 embedding endpoint (plain HTTP by operator decision)
# -----------------------------------------------------------------------------
# Random secret of at least 32 URL-safe characters, different from D3_API_KEY.
# Copy it to BGE_M3_API_KEY on the LiteLLM dev host.
BGE_M3_API_KEY=replace_with_random_32_byte_bge_m3_api_key
BGE_M3_BIND_ADDRESS=0.0.0.0
BGE_M3_PUBLIC_PORT=8080
BGE_M3_MEMORY_LIMIT=8g
# Token budget of one batch on the GPU; bounds TEI's activation memory.
BGE_M3_MAX_BATCH_TOKENS=16384
BGE_M3_MAX_CLIENT_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
# GPU both models share (nvidia-smi index or UUID).
GPU_DEVICE_ID=0
# Seconds to wait for model download, load, and readiness probes.
STARTUP_TIMEOUT=1800
