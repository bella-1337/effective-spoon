# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
.envrc

# Locally generated TLS material
traefik/certs/*
!traefik/certs/.gitkeep
traefik/acme.json
acme.json
litellm/secrets/

# Runtime output
*.log
logs/
backups/
upgrade-state/
docker-compose.override.yml
security-metrics/*
!security-metrics/.gitkeep
security-reports/*
!security-reports/.gitkeep
security-state/*
!security-state/.gitkeep

# Python runtime artifacts
__pycache__/
*.py[cod]

# OS and editor state
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Remote GPU host deployment state (secrets, certificates, model caches)
gpu-host/state/
