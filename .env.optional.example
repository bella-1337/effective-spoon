# Copy this file to .env.optional only when enabling an optional profile.
# Keep the resulting file private and load it after .env:
# docker compose --env-file .env --env-file .env.optional --profile grafana up -d

# -----------------------------------------------------------------------------
# OPTIONAL Grafana profile
# OpenSearch Dashboards remains the default multi-user observability UI.
# -----------------------------------------------------------------------------
# Public hostnames reuse STACK_DOMAIN from .env; set a full hostname to override.
GRAFANA_HOST=grafana.${STACK_DOMAIN}
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECURITY_SECRET_KEY=
GRAFANA_DATABASE_USER=grafana_ro
GRAFANA_DATABASE_PASSWORD=
GRAFANA_ALLOW_SIGN_UP=false

# -----------------------------------------------------------------------------
# OPTIONAL Langfuse profile
# The profile preflight refuses to start until every required value is set.
# -----------------------------------------------------------------------------
LANGFUSE_WEB_HOST=langfuse.${STACK_DOMAIN}
LANGFUSE_S3_HOST=langfuse-s3.${STACK_DOMAIN}
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_REDIS_TLS_ENABLED=false
LANGFUSE_INIT_ORG_ID=litellm-stack
LANGFUSE_INIT_ORG_NAME=LiteLLM Stack
LANGFUSE_INIT_PROJECT_ID=litellm
LANGFUSE_INIT_PROJECT_NAME=LiteLLM
LANGFUSE_TRUSTED_PROXY_COUNT=1
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true

# -----------------------------------------------------------------------------
# OPTIONAL LiteLLM Lens profile (agent-trace analysis)
# Also set LITELLM_LENS_SERVICE_TOKEN and LENS_GATEWAY_SECRET in .env. The
# preflight refuses to start until every secret below and in .env is set;
# `scripts/lens.py secrets` fills empty values without rotating existing ones.
# -----------------------------------------------------------------------------
LENS_HOST=lens.${STACK_DOMAIN}
# Administrator sign-in for the standalone Lens UI and API (32-512 characters).
LENS_ADMIN_TOKEN=
LENS_CLICKHOUSE_PASSWORD=
# Days Lens keeps agent traces in ClickHouse.
LENS_TRACE_RETENTION_DAYS=14
# Optional analysis models through a LiteLLM gateway, for example
# http://litellm-prod:4000 and a virtual key limited to the analysis models.
# Investigations send selected trace content to those models; leave both empty
# to record and inspect traces only.
LENS_GATEWAY_API_BASE=
LENS_GATEWAY_API_KEY=
LENS_CPU_LIMIT=2
LENS_MEMORY_LIMIT=2g
LENS_PIDS_LIMIT=128
LENS_TMP_SIZE=1g

# -----------------------------------------------------------------------------
# OPTIONAL on-host D3-mini profile (d3): coding-router decisions on this host's
# NVIDIA GPU. Also set D3_DECISION_API_BASE=http://d3-mini:8000 and a random
# D3_DECISION_API_KEY in .env. Needs NVIDIA driver 580+ and the NVIDIA
# Container Toolkit. The preflight refuses values outside the ranges below.
# -----------------------------------------------------------------------------
# Longest input D3-mini reads, in tokens (512-8192). 4096 suits a 16 GB card;
# longer prompts are classified by LiteLLM's local heuristic.
D3_MAX_INPUT_TOKENS=4096
# Share of the GPU's memory vLLM reserves at start-up (0.50-0.95).
D3_GPU_MEMORY_UTILIZATION=0.90
# nvidia-smi index or GPU UUID of the card D3-mini uses.
D3_GPU_DEVICE_ID=0
D3_CPU_LIMIT=4
D3_MEMORY_LIMIT=16g
D3_SHM_SIZE=2g

# -----------------------------------------------------------------------------
# OPTIONAL documentation site profile (docs)
# Serves this repository's documentation with `zensical serve` behind Traefik,
# from the checked-out revision built into the image (one version, no version
# selector). Export STACK_REPOSITORY_REVISION before building so the pages name
# that commit. No sign-in: anyone who can reach Traefik can read it.
# -----------------------------------------------------------------------------
DOCS_HOST=gateway-deployment-docs.${STACK_DOMAIN}

# -----------------------------------------------------------------------------
# OPTIONAL image-security monitor profile
# Linux UID/GID must own security-state/, security-reports/, and security-metrics/.
# -----------------------------------------------------------------------------
IMAGE_SECURITY_UID=1000
IMAGE_SECURITY_GID=1000
IMAGE_SECURITY_SCHEDULE_HOUR=2
IMAGE_SECURITY_SCHEDULE_MINUTE=45
IMAGE_SECURITY_RUN_ON_START=true
IMAGE_SECURITY_SBOM_ENABLED=true
IMAGE_SECURITY_SBOM_LICENCE_SCAN=true
IMAGE_SECURITY_SBOM_RETENTION_DAYS=400
IMAGE_SECURITY_CPU_LIMIT=2
IMAGE_SECURITY_MEMORY_LIMIT=2500m
IMAGE_SECURITY_PIDS_LIMIT=256
IMAGE_SECURITY_RESTART_POLICY=on-failure:5
