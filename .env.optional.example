# Copy this file to .env.optional only when enabling an optional profile.
# Keep the resulting file private and load it after .env:
# docker compose --env-file .env --env-file .env.optional --profile grafana up -d

# -----------------------------------------------------------------------------
# OPTIONAL Grafana profile
# OpenSearch Dashboards remains the default multi-user observability UI.
# -----------------------------------------------------------------------------
# Public hostnames reuse STACK_DOMAIN from .env; set a full hostname to override.
GRAFANA_HOST=grafana.${STACK_DOMAIN}
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECURITY_SECRET_KEY=
GRAFANA_DATABASE_USER=grafana_ro
GRAFANA_DATABASE_PASSWORD=
GRAFANA_ALLOW_SIGN_UP=false

# -----------------------------------------------------------------------------
# OPTIONAL Langfuse profile
# The profile preflight refuses to start until every required value is set.
# -----------------------------------------------------------------------------
LANGFUSE_WEB_HOST=langfuse.${STACK_DOMAIN}
LANGFUSE_S3_HOST=langfuse-s3.${STACK_DOMAIN}
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_REDIS_TLS_ENABLED=false
LANGFUSE_INIT_ORG_ID=litellm-stack
LANGFUSE_INIT_ORG_NAME=LiteLLM Stack
LANGFUSE_INIT_PROJECT_ID=litellm
LANGFUSE_INIT_PROJECT_NAME=LiteLLM
LANGFUSE_TRUSTED_PROXY_COUNT=1
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true

# -----------------------------------------------------------------------------
# OPTIONAL image-security monitor profile
# Linux UID/GID must own security-state/, security-reports/, and security-metrics/.
# -----------------------------------------------------------------------------
IMAGE_SECURITY_UID=1000
IMAGE_SECURITY_GID=1000
IMAGE_SECURITY_SCHEDULE_HOUR=2
IMAGE_SECURITY_SCHEDULE_MINUTE=45
IMAGE_SECURITY_RUN_ON_START=true
IMAGE_SECURITY_CPU_LIMIT=2
IMAGE_SECURITY_MEMORY_LIMIT=2500m
IMAGE_SECURITY_PIDS_LIMIT=256
IMAGE_SECURITY_RESTART_POLICY=on-failure:5
